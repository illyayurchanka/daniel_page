---
// src/pages/index.astro
import danielPortrait from '../assets/IndexPage/Daniel_Face.png';
import pioneersBanner from '../assets/pioneers-of-pagonia/BigPicture.jpg';
import unheardBanner from '../assets/unheard-scream/BigPicture.PNG';
import dodgeballBanner from '../assets/magic-dodgeball/BigArt.png';
import kinpathBanner from '../assets/kin-path/BigPicture.jpg';
---

<html lang="en">
<head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Daniel Velitskiy Portfolio | Game Designer</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    </head>
    <body>
        <header class="top-nav">
            <div class="nav-left">Daniel Velitskiy Portfolio | Game Designer</div>
            <div class="header-links">
                <a href="mailto:velickijdaniel@gmail.com" class="contact-link">
                    <span class="link-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </span>
                    velickijdaniel@gmail.com
                </a>
                <a href="https://www.linkedin.com/in/d-velitskiy/" class="contact-link" target="_blank" rel="noopener noreferrer">
                    <span class="link-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </span>
                    LinkedIn
                </a>
                <a href="/pdfs/CV_Game Designer_Daniel Velitskiy.pdf" class="contact-link download-cv" download>
                    <span class="link-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                    </span>
                    CV
                </a>
            </div>
        </header>
		<main class="container">
			<h1 class="page-title">Daniel Velitskiy Portfolio | Game Designer</h1>

			<section class="hero-section">
				<img src={danielPortrait.src} alt="Daniel Velitskiy" class="profile-image" />

				<div class="hero-content">
					<p class="bio-text">
						Game Designer with studio experience in designing core mechanics, systems balancing, and level design. Creator of <strong>Unheard Scream</strong> (60,000+ downloads) and <strong>Magic Dodgeball: Homeless Edition</strong> (exhibited at Gamescom 2025).
					</p>

					<blockquote class="testimonial">
						<p class="quote-text">
							"Daniel demonstrated outstanding dedication and a detailed understanding of complex game design. His analytical skills highly contributed to identifying and evaluating flaws, and he carried out his responsibilities with a high degree of independence."
						</p>
						<cite class="quote-author">— Volker Wertich, Creative Director (Envision Entertainment / Creator of The Settlers)</cite>
                        <a href="/pdfs/Volker Wertich_Letter of Recommendation.pdf" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline; display: inline-flex; align-items: center; gap: 0.5rem;" download>
                               Recommendation Letter by Volker Wertich.pdf
                        </a>
					</blockquote>

                    <div class="header-links">
                        <a href="/pdfs/CV_Game Designer_Daniel Velitskiy.pdf" class="contact-link download-cv" download>
                            <span class="link-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </span>
                            Download my CV here
                        </a>
                    </div>
				</div>
			</section>

			<hr class="section-divider" />

			<section class="skills-section">
				<h2>Core Skills & Tools</h2>
				<ul class="skills-list">
					<li>
						<strong>Core Design Expertise:</strong> Mechanic Conceptualization & Edge Case Logic, Core Loop & Meta-Progression Design, Systems & Economy Balancing, Level Design, Game Design Documentation (GDD).
					</li>
					<li>
						<strong>Software & Engines:</strong> Unreal Engine, Unity, Miro, Excel, Jira (Scrum), Autodesk Maya.
					</li>
				</ul>
			</section>

			<section class="games-section">
				<div class="games-header">
					<h2>Featured Games</h2>
				</div>

                <div class="games-grid">
                    <a href="/pioneers-of-pagonia" class="game-card">
                        <img src={pioneersBanner.src} alt="Pioneers of Pagonia" class="card-image" />
                        <div class="card-info">
                            <h3>Pioneers of Pagonia</h3>
                        </div>
                    </a>

                    <a href="/unheard-scream" class="game-card">
                        <img src={unheardBanner.src} alt="Unheard Scream" class="card-image" />
                        <div class="card-info">
                            <h3>Unheard Scream</h3>
                        </div>
                    </a>

                    <a href="/magic-dodgeball" class="game-card">
                        <img src={dodgeballBanner.src} alt="Magic Dodgeball" class="card-image" />
                        <div class="card-info">
                            <h3>Magic Dodgeball</h3>
                        </div>
                    </a>

                    <a href="/kinpath" class="game-card">
                        <img src={kinpathBanner.src} alt="KinPath" class="card-image" />
                        <div class="card-info">
                            <h3>KinPath</h3>
                        </div>
                    </a>
                </div>
			</section>
		</main>
	</body>
</html>
<style>
    /* Global Resets and Theme Variables */
    :root {
        --bg-color: #191919;
        --text-main: #ffffff;
        --text-muted: rgba(255, 255, 255, 0.6);
        --border-color: rgba(255, 255, 255, 0.1);
        --block-placeholder: #2c2c2c;
        --font-stack: 'Inter', system-ui, -apple-system, sans-serif;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: var(--font-stack);
        line-height: 1.6;
        padding-bottom: 5rem;
        -webkit-font-smoothing: antialiased;
    }

    /* Top Navigation Bar */
    .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .nav-left {
        font-weight: 500;
        color: var(--text-main);
    }

    /* Header Contact Links Container */
    .header-links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
    }

    @media (max-width: 640px) {
        .top-nav {
            flex-direction: column;
            gap: 0.5rem;
            align-items: flex-start;
            padding: 1rem 1.5rem;
        }
        .header-links {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }

    /* Contact & File Links Layout */
    .contact-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;

        /* ADD THESE LINES */
        display: inline-flex;
        align-items: center;
        gap: 0.5rem; /* Adjusts space between icon and text */
    }

    .contact-link:hover {
        color: var(--text-main);
        text-decoration: underline;
    }

    .download-cv {
        color: rgba(255, 255, 255, 0.8);
    }

    .file-size {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.4);
        margin-left: 0.1rem;
    }

    /* Container Layout */
    .container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
    }

    .page-title {
        font-size: 2.25rem;
        font-weight: 700;
        margin-bottom: 2.5rem;
        letter-spacing: -0.02em;
    }

    /* Hero Section Split Layout */
    .hero-section {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-bottom: 3rem;
    }

    @media (max-width: 768px) {
        .hero-section {
            grid-template-columns: 1fr;
        }
    }

    /* Profile Image */
    .profile-image {
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 6px;
        object-fit: cover;
    }

    /* Hero Text Blocks */
    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .bio-text {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.9);
    }

    /* Blockquote Styling */
    .testimonial {
        border-left: 3px solid rgba(255, 255, 255, 0.3);
        padding-left: 1.25rem;
        margin: 0.5rem 0;
    }

    .quote-text {
        font-style: italic;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .quote-author {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        font-style: normal;
    }

    /* Layout Partitions */
    .section-divider {
        border: 0;
        border-top: 1px solid var(--border-color);
        margin: 2.5rem 0;
    }

    /* Skills Section */
    .skills-section h2, .games-header h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-main);
    }

    .skills-list {
        list-style-type: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .skills-list li {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.85);
        position: relative;
        padding-left: 1.25rem;
    }

    .skills-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--text-muted);
    }

    /* Games Section Structure */
    .games-section {
        margin-top: 3rem;
    }

    .games-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    /* Cards Grid System */
    .games-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    @media (max-width: 900px) {
        .games-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .games-grid {
            grid-template-columns: 1fr;
        }
    }

    .game-card {
        background: #202020;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        transition: transform 0.2s ease;
    }

    .game-card:hover {
        transform: translateY(-2px);
    }

    .card-image {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
    }

    .card-info {
        padding: 0.75rem;
    }

    .card-info h3 {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-main);
    }
</style>
