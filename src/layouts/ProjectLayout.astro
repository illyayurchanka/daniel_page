---
// src/layouts/ProjectLayout.astro
import Header from '../components/Header.astro'; // Import the new component
import '../styles/global.css';

interface Props {
    title: string;
    icon: string;
    bannerText: string;
    currentBreadcrumb: string;
    metadata: Array<{ label: string; value: string }>;
    bannerImage?: string;
}

const { title, icon, bannerText, currentBreadcrumb, metadata, bannerImage } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} | Daniel Velitskiy</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    </head>
    <body>
        <Header currentBreadcrumb={currentBreadcrumb} />

        {
            bannerImage ? (
                <img src={bannerImage} alt={bannerText} class="page-banner-image" />
            ) : (
                <div class="page-banner-placeholder">
                    <span>{bannerText}</span>
                </div>
            )
        }

        <main class="container">
            <div class="page-header-title">
                <div class="page-icon">{icon}</div>
                <h1>{title}</h1>
            </div>

            <section class="metadata-table">
                {metadata.map((item) => (
                    <div class="meta-row">
                        <div class="meta-label">{item.label}</div>
                        <div class="meta-value">{item.value}</div>
                    </div>
                ))}
            </section>

            <slot />
        </main>
    </body>
</html>

<style is:global>
    /* Global Design Elements across all Project Pages */
    :root {
        --bg-color: #191919;
        --text-main: #ffffff;
        --text-muted: rgba(255, 255, 255, 0.45);
        --text-body: rgba(255, 255, 255, 0.9);
        --border-color: rgba(255, 255, 255, 0.1);
        --block-placeholder: #202020;
        --font-stack: 'Inter', system-ui, -apple-system, sans-serif;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: var(--font-stack);
        line-height: 1.65;
        padding-bottom: 6rem;
        padding-top: 50px; /* Offset for the 50px fixed header */
        -webkit-font-smoothing: antialiased;
    }

    /* Note: Top Nav CSS has been moved to Header.astro */

    .page-banner-placeholder {
        width: 100%;
        height: 260px;
        background: linear-gradient(135deg, #23272a 0%, #0f1112 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.25);
        font-size: 1rem;
        border-bottom: 1px solid var(--border-color);
        font-weight: 500;
    }

    .page-banner-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
        border-bottom: 1px solid var(--border-color);
    }

    .container { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.5rem; }
    .page-header-title { position: relative; margin-bottom: 2rem; }

    .page-icon {
        font-size: 4.5rem;
        margin-top: -4.5rem;
        margin-bottom: 1rem;
        display: inline-block;
        background-color: var(--bg-color);
        border-radius: 12px;
        padding: 0.25rem;
    }

    .page-header-title h1 { font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; }

    /* Metadata Component Style */
    .metadata-table { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 2.5rem; font-size: 0.9rem; }
    .meta-row { display: grid; grid-template-columns: 120px 1fr; align-items: center; }
    .meta-label { color: var(--text-muted); }
    .meta-value { color: var(--text-body); }

    /* Shared typography styling used inside pages */
    .content-section { margin-bottom: 2.5rem; }
    .content-section h2 { font-size: 1.35rem; font-weight: 600; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; }
    .content-section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main); }

    .content-section p { color: var(--text-body); font-size: 1rem; margin-bottom: 1.25rem; }

    .impact-list { list-style-type: none; display: flex; flex-direction: column; gap: 1rem; }
    .impact-list li { font-size: 0.95rem; color: var(--text-body); position: relative; padding-left: 1.25rem; }
    .impact-list li::before { content: "•"; position: absolute; left: 0; color: var(--text-muted); font-size: 1.2rem; top: -2px; }

    /* Video Layout */
    .video-placeholder {
        width: 100%;
        aspect-ratio: 16 / 9;
        background-color: #0b0b0b;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        gap: 1rem;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        cursor: pointer;
    }

    /* Document/Visual Proof Showcase blocks */
    .deep-dive-block {
        margin-bottom: 2rem;
    }
    .asset-placeholder-block {
        width: 100%;
        background-color: #222;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        margin: 0.75rem 0 1.25rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.4);
        font-size: 0.85rem;
        padding: 1rem;
    }
    .asset-image-wrapper {
        margin: 0.75rem 0 1.25rem 0;
    }

    .asset-caption {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 0.5rem;
        text-align: center;
    }
</style>
