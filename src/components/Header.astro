---
// src/components/Header.astro
interface Props {
    currentBreadcrumb: string;
}

const { currentBreadcrumb } = Astro.props;
---

<header class="top-nav">
    <div class="nav-left">
        <a href="/" class="breadcrumb-link">Daniel Velitskiy Portfol...</a>
        <span class="separator">/</span>
        <span class="current-page">{currentBreadcrumb}</span>
    </div>
    <div class="header-links">
        <a href="mailto:velickijdaniel@gmail.com" class="contact-link">
            <span class="link-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
            </span>
            velickijdaniel@gmail.com
        </a>
        <a href="https://www.linkedin.com/in/d-velitskiy/" class="contact-link" target="_blank" rel="noopener noreferrer">
            <span class="link-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
            </span>
            LinkedIn
        </a>
        <a href="/pdfs/CV_Game Designer_Daniel Velitskiy.pdf" class="contact-link download-cv" download>
            <span class="link-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </span>
            CV
        </a>
    </div>
</header>
<style>
    .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 50px; /* Fixed height so we can offset the body */
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1.5rem;
        font-size: 0.85rem;

        /* Glassmorphism effect to float nicely over banner images */
        background-color: rgba(25, 25, 25, 0.85); /* Matches your --bg-color */
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        z-index: 1000;
    }

    .breadcrumb-link {
        color: rgba(255, 255, 255, 0.45);
        text-decoration: none;
    }

    .breadcrumb-link:hover {
        text-decoration: underline;
        color: #ffffff;
    }

    .separator {
        margin: 0 0.35rem;
        color: rgba(255, 255, 255, 0.2);
    }

    .current-page {
        color: #ffffff;
    }

    .header-links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
    }
    @media (max-width: 640px) {
        .top-nav {
            flex-direction: column;
            gap: 0.5rem;
            align-items: flex-start;
            padding: 1rem 1.5rem;
        }
        .header-links {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }

    /* Contact & File Links Layout */
    .contact-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;

        /* ADD THESE LINES */
        display: inline-flex;
        align-items: center;
        gap: 0.5rem; /* Adjusts space between icon and text */
    }

    .contact-link:hover {
        color: var(--text-main);
        text-decoration: underline;
    }

    .download-cv {
        color: rgba(255, 255, 255, 0.8);
    }

</style>
